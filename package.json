{
  "name": "dsh-translate-this",
  "version": "0.8.0",
  "description": "يترجم الردود ومخرجات الأدوات ومعاينات الملفات ولوحات البلاقنات في DSH عند الطلب — بنموذج المستخدم نفسه، بلا خدمة ترجمة خارجية وبلا نموذج محلي. Translate This: on-demand content translation for DeepSeek Harness, replies / tool output / file previews / plugin panels, with your own model.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "acceptance": "node acceptance/run.mjs",
    "protocol": "node acceptance/protocol.mjs",
    "golden": "node acceptance/golden.mjs",
    "creed": "node tools/creed-gate.mjs",
    "glossary": "node tools/glossary-build.mjs",
    "gates": "node acceptance/protocol.mjs && node tools/creed-gate.mjs && node acceptance/run.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "translate",
    "translation",
    "on-demand",
    "in-place",
    "arabic",
    "rtl",
    "tarjama",
    "tarjim"
  ],
  "files": [
    "lib/**/*.js",
    "data/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "NOTICE.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SMSMy/dsh-translate-this.git"
  }
}
